.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# =============================================================================
# Python Bytecode, Caches & Distribution
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# =============================================================================
# Jupyter Notebook Checkpoints & Cache
# =============================================================================
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# =============================================================================
# Geospatial, Remote Sensing Data & Outputs
# =============================================================================
# Keep Data subdirectories via .gitkeep
!Data/**/.gitkeep

# Ignore large raw satellite raster composites
Data/rasters/raw/*.tif

# Ignore intermediate uncompressed raw tabular dumps
Data/tables/EO_feature_table_unlabeled.csv
Data/tables/EO_feature_table_labelled.csv

# Allow generated figures, maps, and dashboards
!Data/figures/**
!Data/figures/*.png
!Data/figures/*.jpg

# Allow model weights and metadata
!Data/models/**

# Allow verified spatial test predictions and ablation benchmarks
!Data/tables/RF_spatial_test_predictions.csv
!Data/tables/EO_feature_table_spatial_split.csv
!Data/tables/ablation_results.csv

# Allow generated GIS decision-support GeoTIFF products
!Data/rasters/gis_products/**
!Data/rasters/gis_products/*.tif

# Generic archive/compressed formats
*.vrt
*.nc
*.hdf
*.h5
*.zip
*.tar.gz

# =============================================================================
# IDE, Editor & OS Artifacts
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# =============================================================================
# Logs & Temporary Files
# =============================================================================
*.log
scratch/
tmp/
temp/